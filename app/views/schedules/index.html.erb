<h3>予定一覧</h3>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
    </tr>
  </thead>

  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.to_fs(:date_jp) %></td>
        <td><%= schedule.end_date.to_fs(:date_jp) %></td>
        <td><%= schedule.is_all_day %></td>
        <td><%= schedule.updated_at.to_fs(:datetime_jp) %></td>
        <td>
          <%= link_to "参照", schedule %>
        </td>
        <td>
          <%= link_to "編集", [:edit, schedule] %>
        </td>
        <td>
          <%= link_to "削除", schedule, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "予定を新規登録する", :new_schedule %></p>

