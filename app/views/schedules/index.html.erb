<h3 class="page-title">予定一覧</h3>
<table class="schedule-table">
  <thead>
    <tr>
      <th class="table-header">ID</th>
      <th class="table-header">タイトル</th>
      <th class="table-header">開始日</th>
      <th class="table-header">終了日</th>
      <th class="table-header">終日</th>
      <th class="table-header">更新日時</th>
    </tr>
  </thead>

  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td class="table-data"><%= schedule.id %></td>
        <td class="table-data"><%= schedule.title %></td>
        <td class="table-data"><%= schedule.start_date %></td>
        <td class="table-data"><%= schedule.end_date %></td>
        <td class="table-data"><%= schedule.is_all_day %></td>
        <td class="table-data"><%= schedule.updated_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "予定を新規登録する", :new_schedule %></p>

