<div class="d-flex justify-content-between flex-grow-1">
  <h3 class="page-title">予定一覧</h3>
  <p><%= link_to "新規登録", :new_schedule, class: "btn btn-primary" %></p>
</div>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr>
        <th style="width: 50px">ID</th>
        <th>タイトル</th>
        <th style="width: 12%">開始日</th>
        <th style="width: 12%">終了日</th>
        <th style="width: 50px">終日</th>
        <th style="width: 16%">更新日時</th>
        <th colspan="3"></th>
      </tr>
    </thead>

    <tbody>
      <% @schedules.each do |schedule| %>
        <tr>
          <td><%= schedule.id %></td>
          <td><%= schedule.title %></td>
          <td><%= schedule.start_date.to_fs(:date_jp) %></td>
          <td><%= schedule.end_date.to_fs(:date_jp) %></td>
          <td><%= schedule.is_all_day %></td>
          <td><%= schedule.updated_at.to_fs(:datetime_jp) %></td>
          <td style="width: 6%">
            <%= link_to "参照", schedule, class: "btn btn-outline-primary btn-sm"%>
          </td>
          <td style="width: 6%">
            <%= link_to "編集", [:edit, schedule], class: "btn btn-outline-success btn-sm" %>
          </td>
          <td style="width: 6%">
            <%= link_to "削除", schedule, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger btn-sm"%>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<footer class="footer mt-auto py-3 bg-light border-top">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <span>予定件数: <%= @schedules.count %></span>
      </div>
      <div>
        <span><%= Date.today.to_fs(:date_jp) %></span>
      </div>
    </div>
  </div>
</footer>
