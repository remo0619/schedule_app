<h3 class="page-title">予定新規作成</h3>

<%= form_with model: @schedule do |f| %>
  <table class="table w-75">
    <tr>
      <th style="width: 20%"><%= f.label :title, "タイトル" %></th>
      <td colspan="3">
      <%= f.text_field :title, size: 60 %>
      <% if @schedule.errors[:title].any? %>
        <div class="invalid-feedback d-block small">
          <%= @schedule.errors.full_messages_for(:title).first %>
        </div>
      <% end %>
      </td>
    </tr>
    <tr>
      <th><%= f.label :start_date, "開始日" %></th>
      <td>
        <%= f.text_field :start_date, class: "datetimepicker w-50" %>
        <% if @schedule.errors[:title].any? %>
          <div class="invalid-feedback d-block small">
            <%= @schedule.errors.full_messages_for(:start_date).first %>
          </div>
        <% end %>
      </td>
      <th><%= f.label :end_date, "終了日" %></th>
      <td>
        <%= f.text_field :end_date, class: "datetimepicker w-50"  %>
        <% if @schedule.errors[:title].any? %>
          <div class="invalid-feedback d-block small">
            <%= @schedule.errors.full_messages_for(:end_date).first %>
          </div>
        <% end %>
      </td>
    </tr>
    <tr>
      <th><%= f.label :is_all_day, "終日" %></th>
      <td colspan="3"><%= f.check_box :is_all_day %></td>
    </tr>
    <tr>
      <th><%= f.label :schedule_memo, "メモ" %></th>
      <td colspan="3">
        <%= f.text_area :schedule_memo, size: "60x5" %>
        <% if @schedule.errors[:title].any? %>
          <div class="invalid-feedback d-block small">
            <%= @schedule.errors.full_messages_for(:schedule_memo).first %>
          </div>
        <% end %>
      </td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "登録完了", class: "btn btn-primary" %></li>
      <li><%= link_to "予定一覧へ戻る", :schedules, class: "btn btn-secondary"  %></li>
    </ul>
  </div>
<% end %>

