<h3 class="page-title">予定新規作成</h3>

<%= form_with model: @schedule do |f| %>
  <table class="schedule-create-table">
    <tr>
      <th><%= f.label :title, "タイトル" %></th>
      <td><%= f.text_field :title, size: 60 %></td>
    </tr>
    <tr>
      <th><%= f.label :start_date, "開始日" %></th>
      <td><%= f.text_field :start_date %></td>
    </tr>
    <tr>
      <th><%= f.label :end_date, "終了日" %></th>
      <td><%= f.text_field :end_date %></td>
    </tr>
    <tr>
      <th><%= f.label :schedule_memo, "メモ" %></th>
      <td><%= f.text_area :schedule_memo, size: "60x5" %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "登録完了" %></li>
      <li><%= link_to "予定一覧へ戻る", :schedules %></li>
    </ul>
  </div>
<% end %>

