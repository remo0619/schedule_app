<h3 class="page-title">予定詳細</h3>

<table class="table w-75">
  <tr>
    <th style="width: 20%">タイトル</th>
    <td><%= @schedule.title %></td>
  </tr>
  <tr>
    <th>開始日</th>
    <td><%= @schedule.start_date %></td>
  </tr>
  <tr>
    <th>終了日</th>
    <td><%= @schedule.end_date %></td>
  </tr>
  <tr>
    <th>終日</th>
    <td><%= @schedule.is_all_day %></td>
  </tr>
  <tr>
    <th>メモ</th>
    <td><%= @schedule.schedule_memo %></td>
  </tr>
</table>

<div>
  <ul>
    <li><%= link_to "予定一覧へ戻る", :schedules, class: "btn btn-secondary" %></li>
  </ul>
</div>