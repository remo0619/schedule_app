<h3 class="page-title">予定編集</h3>

<%= render "shared/error", obj: @schedule%>

<%= form_with model: @schedule do |f| %>
  <table class="table w-75">
    <tr>
      <th style="width: 20%"><%= f.label :title, "タイトル" %></th>
      <td colspan="3"><%= f.text_field :title, size: 60 %></td>
    </tr>
    <tr>
      <th><%= f.label :start_date, "開始日" %></th>
      <td><%= f.text_field :start_date, class: "datetimepicker" %></td>
      <th><%= f.label :end_date, "終了日" %></th>
      <td><%= f.text_field :end_date, class: "datetimepicker" %></td>
    </tr>
    <tr>
      <th><%= f.label :is_all_day, "終日" %></th>
      <td colspan="3"><%= f.check_box :is_all_day, {}, "⚪︎", "" %></td>
    </tr>
    <tr>
      <th><%= f.label :schedule_memo, "メモ" %></th>
      <td colspan="3"><%= f.text_area :schedule_memo, size: "60x5" %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "編集完了", class: "btn btn-success" %></li>
      <li><%= link_to "予定一覧へ戻る", :schedules, class: "btn btn-secondary" %></li>
    </ul>
  </div>
<% end %>

